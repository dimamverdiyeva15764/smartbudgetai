# Copy to backend/.env for reference; set the same names in Vercel → Settings → Environment Variables.
# Secret values — never commit real ones.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
GROQ_API_KEY=

# Non-secret options
DEBUG=False
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=12
AUTO_MIGRATE=true
